# Copy this file to .env for local development.
# When deployed (Render, Railway, …), set these as environment variables instead.

# MongoDB Atlas connection string: Atlas → your cluster → Connect → Drivers.
# Leave empty locally to use a temporary in-memory database (wiped when the server stops).
MONGODB_URI=

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET signs login tokens; DEVICE_API_KEY is what each ESP32 sends in the X-Device-Key header.
JWT_SECRET=
DEVICE_API_KEY=

PORT=4000

# Optional
# NODE_ENV=production
# CORS_ORIGIN=*
# JWT_EXPIRES_IN=30d
# HISTORY_RETENTION_DAYS=30
# AUTH_RATE_LIMIT=30

# Optional: email password-reset codes. Without SMTP, codes are printed in the server log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Sparsh <you@gmail.com>

# Optional: SMS alerts to the caretaker on ATTENTION and CRITICAL, sent with Twilio
# (twilio.com → Console → Account Info). Without these, the texts are printed in the server log.
# A trial account can only text numbers verified under Phone Numbers → Verified Caller IDs.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15551234567
# SMS_COUNTRY_CODE=+91
# SMS_COOLDOWN_MINUTES=10
